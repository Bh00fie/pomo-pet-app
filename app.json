{
  "expo": {
    "name": "Pomo Pet",
    "slug": "pomo-pet-app",
    "scheme": "pomopet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07131F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bh00fie.pomopet"
    },
    "android": {
      "package": "com.bh00fie.pomopet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07131F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
